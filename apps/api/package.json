{
  "name": "@wdrg/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API for the requirement analysis and documentation generator",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.ts",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.ts --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.ts --coverage",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.e2e.config.ts --runInBand",
    "test:ollama": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.ollama.config.ts --runInBand"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.3",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@wdrg/config": "workspace:*",
    "@wdrg/contracts": "workspace:*",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "mammoth": "1.12.0",
    "minio": "8.0.7",
    "mongoose": "9.9.1",
    "multer": "2.2.0",
    "nestjs-pino": "4.6.1",
    "pdfjs-dist": "6.2.108",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "@wdrg/eslint-config": "workspace:*",
    "@wdrg/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "jest": "30.4.2",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
