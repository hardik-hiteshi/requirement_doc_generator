{
  "name": "@wdrg/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Browser end-to-end suite: the real Next.js and NestJS applications against an isolated MongoDB",
  "scripts": {
    "clean": "rm -rf .artifacts playwright-report test-results .turbo *.tsbuildinfo",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/prepare-run.mjs && node scripts/build-web.mjs && playwright test",
    "test:e2e:ui": "node scripts/prepare-run.mjs && node scripts/build-web.mjs && playwright test --ui",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@wdrg/api": "workspace:*",
    "@wdrg/contracts": "workspace:*",
    "@wdrg/eslint-config": "workspace:*",
    "@wdrg/testing": "workspace:*",
    "@wdrg/typescript-config": "workspace:*",
    "@wdrg/web": "workspace:*",
    "axe-core": "4.12.1",
    "eslint": "10.8.0",
    "mongodb": "7.5.0",
    "typescript": "5.9.3"
  }
}
