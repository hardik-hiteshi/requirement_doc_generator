{
  "extends": "@wdrg/typescript-config/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    // The DOM lib is for `page.evaluate` callbacks, which are compiled here but
    // execute inside the browser.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["tests/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".artifacts", "playwright-report", "test-results"]
}
