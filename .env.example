# =============================================================================
# Environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored; only this example is tracked.
# Never put a real secret in this file.
#
# Every variable below is validated at startup. A missing or malformed value
# fails the process immediately with a list of every problem — see
# packages/config/src/parse-env.ts.
# =============================================================================

# Deployment environment: development | test | production
NODE_ENV=development


# ------------------------------------------------------------------ API server
# Port the NestJS API listens on.
API_PORT=3001

# Interface to bind. 0.0.0.0 is required inside a container; use 127.0.0.1 to
# restrict the API to the local machine.
API_HOST=0.0.0.0

# Absolute public URL of the API. Used for OpenAPI server metadata and for
# building absolute links. No trailing slash.
API_PUBLIC_URL=http://localhost:3001


# --------------------------------------------------------------------- MongoDB
# Connection string used by the API. `pnpm docker:up` starts a matching local
# instance. In production, supply credentials through your secret manager —
# never here.
MONGODB_URI=mongodb://localhost:27017/wdrg

# Host port the Docker Compose MongoDB binds to. Infrastructure only: the API
# does not read it, and the container port is always 27017. Change it when
# another MongoDB already owns 27017, and keep MONGODB_URI in step.
# Validated (numeric, 1024-65535) by infrastructure/scripts/compose.sh.
MONGODB_HOST_PORT=27017

# Host port for the optional mongo-express browser (`pnpm docker:tools`).
MONGO_EXPRESS_HOST_PORT=8081

# Docker Compose project name. Namespaces containers and the data volume, so a
# throwaway stack cannot collide with your working data.
COMPOSE_PROJECT_NAME=wdrg-dev

# How long to wait for a server before failing a connection attempt, in ms.
MONGODB_CONNECT_TIMEOUT_MS=10000


# --------------------------------------------------------------------- Logging
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable log output. Development only — production logs must stay JSON
# so they remain machine-parseable.
LOG_PRETTY=true


# -------------------------------------------------------------------- Security
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum accepted request body, in bytes. 1 MiB by default; file uploads use a
# separate streaming path with its own limits (added in the upload phase).
REQUEST_BODY_LIMIT_BYTES=1048576


# ------------------------------------------------------------------- API docs
# Serve the interactive OpenAPI UI at /api/docs. Turn this off in production
# unless the documentation is deliberately public.
OPENAPI_ENABLED=true


# --------------------------------------------------------------- Web front end
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Never put a secret behind a NEXT_PUBLIC_ prefix.

# Absolute base URL the browser uses to reach the API. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Product name shown in the workspace.
NEXT_PUBLIC_APP_NAME=Requirement Documentation Generator


# =============================================================================
# Reserved for later phases — intentionally absent
#
# These are listed so the intended shape is visible, but they are NOT read by
# any code yet. They are added, with validation, by the phase that needs them:
#
#   ANTHROPIC_API_KEY, AI_MODEL, AI_MAX_*        Phase 4  (AI orchestration)
#   STORAGE_DRIVER, STORAGE_LOCAL_PATH, S3_*     Phase 3  (file storage)
#   REDIS_URL                                    Phase 3  (background jobs)
#   PROJECT_SECRET_PEPPER, PROJECT_TTL_DAYS      Phase 2  (anonymous access)
#   RATE_LIMIT_*, CAPTCHA_*                      Phase 12 (abuse controls)
# =============================================================================
