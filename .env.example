# =============================================================================
# Environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored; only this example is tracked.
# Never put a real secret in this file.
#
# Every variable below is validated at startup. A missing or malformed value
# fails the process immediately with a list of every problem — see
# packages/config/src/parse-env.ts.
# =============================================================================

# Deployment environment: development | test | production
NODE_ENV=development


# ------------------------------------------------------------------ API server
# Port the NestJS API listens on.
API_PORT=3001

# Interface to bind. 0.0.0.0 is required inside a container; use 127.0.0.1 to
# restrict the API to the local machine.
API_HOST=0.0.0.0

# Absolute public URL of the API. Used for OpenAPI server metadata and for
# building absolute links. No trailing slash.
API_PUBLIC_URL=http://localhost:3001


# --------------------------------------------------------------------- MongoDB
# Connection string used by the API. `pnpm docker:up` starts a matching local
# instance. In production, supply credentials through your secret manager —
# never here.
MONGODB_URI=mongodb://localhost:27017/wdrg

# Host port the Docker Compose MongoDB binds to. Infrastructure only: the API
# does not read it, and the container port is always 27017. Change it when
# another MongoDB already owns 27017, and keep MONGODB_URI in step.
# Validated (numeric, 1024-65535) by infrastructure/scripts/compose.sh.
MONGODB_HOST_PORT=27017

# Host port for the optional mongo-express browser (`pnpm docker:tools`).
MONGO_EXPRESS_HOST_PORT=8081

# Docker Compose project name. Namespaces containers and the data volume, so a
# throwaway stack cannot collide with your working data.
COMPOSE_PROJECT_NAME=wdrg-dev

# How long to wait for a server before failing a connection attempt, in ms.
MONGODB_CONNECT_TIMEOUT_MS=10000


# --------------------------------------------------------------------- Logging
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable log output. Development only — production logs must stay JSON
# so they remain machine-parseable.
LOG_PRETTY=true


# -------------------------------------------------------------------- Security
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximum accepted request body, in bytes. 1 MiB by default; file uploads use a
# separate streaming path with its own limits (added in the upload phase).
REQUEST_BODY_LIMIT_BYTES=1048576


# ------------------------------------------------------------- Project access
# Absolute public URL of the web application. Used to build recovery links, so
# it must match where users actually reach the workspace.
WEB_PUBLIC_URL=http://localhost:3000

# Signs project session cookies (HMAC-SHA256). Rotating it invalidates every
# live session — that is the intended emergency lever.
# REQUIRED in production: generate with `openssl rand -base64 48`.
# The development default below is deliberately not a secret.
PROJECT_SESSION_SECRET=development-only-session-secret-value-000000

# How long a project session cookie stays valid, in seconds (default 7 days).
PROJECT_SESSION_TTL_SECONDS=604800

# How long an untouched project survives before it expires, in days.
# An expired project can still be read but not edited.
PROJECT_EXPIRY_DAYS=30


# ------------------------------------------------------------------- API docs
# Serve the interactive OpenAPI UI at /api/docs. Turn this off in production
# unless the documentation is deliberately public.
OPENAPI_ENABLED=true


# --------------------------------------------------------------- Web front end
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Never put a secret behind a NEXT_PUBLIC_ prefix.

# Absolute base URL the browser uses to reach the API. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Product name shown in the workspace.
NEXT_PUBLIC_APP_NAME=Requirement Documentation Generator


# =============================================================================
# Reserved for later phases — intentionally absent
#
# These are listed so the intended shape is visible, but they are NOT read by
# any code yet. They are added, with validation, by the phase that needs them:
#
#   AI_MAX_*                                      Phase 4  (AI orchestration)
#   STORAGE_DRIVER, STORAGE_LOCAL_PATH, S3_*     Phase 3  (file storage)
#   REDIS_URL                                    Phase 3  (background jobs)
#   PROJECT_SECRET_PEPPER, PROJECT_TTL_DAYS      Phase 2  (anonymous access)
#   RATE_LIMIT_*, CAPTCHA_*                      Phase 12 (abuse controls)
# =============================================================================

# --- Phase 3: requirement ingestion -------------------------------------------
# Where uploaded files are stored. Never web-served: downloads go through an
# authorized API route, so there is no URL that reaches a file without a session.
UPLOAD_STORAGE_ROOT=./storage/uploads
# Largest single upload, in bytes. Independent of REQUEST_BODY_LIMIT_BYTES above,
# which bounds JSON bodies rather than multipart uploads.
UPLOAD_MAX_FILE_BYTES=26214400
# Total bytes one project may hold across every file.
UPLOAD_MAX_PROJECT_BYTES=262144000
UPLOAD_MAX_FILES_PER_PROJECT=50
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_FILENAME_LENGTH=255

# --- Extraction ---------------------------------------------------------------
# Wall-clock ceiling for reading one source. Bounds a hostile or pathological file.
EXTRACTION_TIMEOUT_MS=120000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BACKOFF_MS=2000
EXTRACTION_POLL_INTERVAL_MS=1000
# A job whose worker died is reclaimable after this long.
EXTRACTION_CLAIM_TIMEOUT_MS=180000
# Set false to leave jobs queued. Tests drive the worker directly so extraction
# is deterministic rather than something that happens at some point after upload.
EXTRACTION_WORKER_ENABLED=true
EXTRACTION_MAX_BLOCKS=20000
EXTRACTION_MAX_ROWS=5000
EXTRACTION_MAX_PAGES=500
# Decompression ceiling for ZIP-container formats. A 1 MB file that expands to
# 1 GB is a zip bomb, not a document.
EXTRACTION_MAX_UNCOMPRESSED_BYTES=209715200

# --- OCR ----------------------------------------------------------------------
# Requires the Tesseract binary. Set false where it is not installed: image
# sources then fail with a clear message rather than returning empty content.
OCR_ENABLED=true
OCR_TESSERACT_BINARY=tesseract
# Tesseract language codes, e.g. eng or eng+deu. Each needs its trained data
# installed (tesseract-ocr-eng, tesseract-ocr-deu, ...).
OCR_LANGUAGES=eng
OCR_TIMEOUT_MS=60000
# Below this mean word confidence a page is flagged for review.
OCR_MIN_CONFIDENCE=0.75

# --- Legacy .doc / .xls conversion --------------------------------------------
# Off by default. Conversion needs headless LibreOffice, a several-hundred-
# megabyte dependency no deployment should acquire as a side effect. While this
# is false, .doc and .xls are refused with a message naming the fix.
LEGACY_CONVERSION_ENABLED=false
LEGACY_CONVERSION_BINARY=soffice
LEGACY_CONVERSION_TIMEOUT_MS=120000

# --- Malware scanning ---------------------------------------------------------
# `none` records NOT_SCANNED and keeps the file; `reject` refuses every upload
# because no scanner is available. A real scanner adapter arrives with the
# deployment phase — see ADR-0016.
MALWARE_SCANNER=none

# --- Storage adapter ----------------------------------------------------------
# `filesystem` (local disk) or `s3` (an S3-compatible server YOU run — MinIO in
# the compose stack). There is no cloud default: choosing `s3` means naming an
# endpoint you operate. Production fails startup if this is `s3` and the settings
# below are incomplete.
STORAGE_ADAPTER=filesystem

# --- Self-hosted object storage (MinIO) ---------------------------------------
# No AWS account and no cloud credentials are involved. S3 here is a wire
# protocol; the server is yours. The compose stack runs MinIO on 9000.
S3_ENDPOINT=127.0.0.1
S3_PORT=9000
# False is correct for a compose-local MinIO on this host. Production refuses
# plaintext to a storage server that is not on the same machine.
S3_USE_SSL=false
S3_BUCKET=wdrg-requirements
# PLACEHOLDERS. Replace them, and never commit real values.
S3_ACCESS_KEY=replace-me-local-access-key
S3_SECRET_KEY=replace-me-local-secret-key
S3_REGION=us-east-1
# Ceiling on a presigned download link. A presigned URL cannot be revoked, so its
# lifetime is the only control over it.
S3_SIGNED_URL_TTL_SECONDS=300

# --- Self-hosted malware scanning (ClamAV) ------------------------------------
# `clamav` is the real scanner. `none` records NOT_SCANNED — never CLEAN — and is
# REJECTED AT STARTUP in production. `reject` refuses every upload, for a
# deployment that would rather accept nothing than accept something unscanned.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Refuse an upload when the scanner cannot be reached. Production is always
# fail-closed regardless of this value: an unreachable scanner must never become
# a silent bypass.
MALWARE_FAIL_CLOSED=true

# --- Docker host ports --------------------------------------------------------
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
CLAMAV_HOST_PORT=3310

# --- AI provider (self-hosted inference only) ---------------------------------
# `ollama` (development) and `local-openai-compatible` (production, e.g. vLLM)
# both mean inference running on YOUR infrastructure. The OpenAI protocol is
# borrowed; the service is not — AI_BASE_URL must never point at a model vendor,
# and production refuses hosted-vendor domains and public addresses outright.
# `deterministic` returns test fixtures and is REJECTED AT STARTUP in production.
# No requirement content leaves the operator's own network. See ADR-0017.
AI_PROVIDER=disabled

# Base URL of the inference server you run. There is deliberately no default: an
# unconfigured deployment fails rather than reaching anywhere.
#   Ollama:  http://127.0.0.1:11434
#   vLLM:    http://vllm.internal:8000
AI_BASE_URL=

# Which model profile to use. Each profile records its licence, its limits and
# how thoroughly it has been validated — see
# apps/api/src/analysis/models/model-profiles.ts and ADR-0018.
#   qwen2.5-7b-instruct            Apache-2.0, the reference profile (~6 GB)
#   qwen2.5-3b-instruct            Apache-2.0, fallback for smaller machines (~2.5 GB)
#   self-hosted-openai-compatible  Name your own model before production use
#   deterministic-test             Test fixtures. Never production.
AI_MODEL_PROFILE=

# Overrides the profile's model name, for a server that publishes it under a
# different tag. The profile still supplies the licence and the limits.
AI_MODEL=

# A local model on CPU is slow. These bound how long a caller waits, not how
# long the hardware works.
AI_REQUEST_TIMEOUT_MS=180000
AI_RUN_TIMEOUT_MS=3600000

# Override the profile's context and output limits, for a server launched with a
# smaller window than the weights support. 0 means "use the profile's value".
AI_MAX_CONTEXT_TOKENS=0
AI_MAX_OUTPUT_TOKENS=0

# Attempts for a retryable provider failure, including the first.
AI_MAX_ATTEMPTS=3

# Whether production refuses a loopback inference endpoint as well as a public
# one. Off by default: "the model runs on this box" is a legitimate — and common
# — production shape for a self-hosted deployment of this size, and refusing it
# would push you towards exposing the inference server on a network instead.
# Turn it on if your own policy requires inference to be a separate internal
# host. See docs/adr/0021-inference-endpoint-hardening.md.
AI_REQUIRE_REMOTE_ENDPOINT=false

# Only meaningful with AI_PROVIDER=deterministic, which production refuses.
# "echo" makes the test provider answer from the evidence it was given, so the
# browser suite can drive the workflow without a model. It invents nothing.
# Leave empty outside tests.
AI_DETERMINISTIC_SCENARIO=
