{
  "name": "@wdrg/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible presentational primitives shared by the web workspace",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wdrg/eslint-config": "workspace:*",
    "@wdrg/typescript-config": "workspace:*",
    "eslint": "10.8.0",
    "react": "19.2.8",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
